# =============================================================================
# driver-app — build configuration template (no secrets; safe to track)
# =============================================================================
# app.config.ts reads these. Locally, copy to `.env.local` (git-ignored) and
# fill in. In CI and on EAS, supply them as EAS secrets instead.
# -----------------------------------------------------------------------------

# Runsheet backend origin the app calls. TLS only — lib/api-client.ts refuses a
# non-https origin (Requirement 15.4), so a local backend must be reached over an
# HTTPS tunnel rather than plain http://localhost.
EXPO_PUBLIC_API_BASE_URL=https://api.example.com

# iOS bundle identifier and Android application id. Runsheet-controlled
# reverse-domain namespace. Immutable once a build carrying them is published.
RUNSHEET_IOS_BUNDLE_IDENTIFIER=com.runsheet.driver
RUNSHEET_ANDROID_PACKAGE=com.runsheet.driver

# EAS account that owns the project, and the EAS project id.
RUNSHEET_EAS_OWNER=
RUNSHEET_EAS_PROJECT_ID=

# Path to the Firebase google-services.json for the Runsheet Firebase project.
# Supplied to EAS as a FILE secret named GOOGLE_SERVICES_JSON. The file itself
# is never committed to this repository.
GOOGLE_SERVICES_JSON=
