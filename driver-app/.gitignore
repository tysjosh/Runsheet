# =============================================================================
# driver-app — Expo / React Native
# =============================================================================
# Build output, native project directories, and dependency directories stay out
# of the git index so the repository's `git-hygiene` job (its check for tracked
# ignored files) keeps passing (Requirement 16.25).

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*

# Native project directories (generated by `expo prebuild`)
/ios/
/android/
.kotlin/
*.orig.*

# Signing material and credentials — never commit
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
google-services.json
GoogleService-Info.plist

# typescript
*.tsbuildinfo

# testing
coverage/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# local env files
.env*.local

# macOS
.DS_Store

# =============================================================================
# Negation — the repository-root .gitignore excludes `lib/` for Python. That
# pattern would otherwise swallow this app's own `lib/` source directory,
# leaving it untracked. Re-include it here; a .gitignore in a subdirectory
# overrides the patterns of its parents.
# =============================================================================
!/lib/
