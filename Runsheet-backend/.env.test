# Test Environment Configuration
# This file contains settings for running pytest tests
# Tests should use mocked services where possible

# Environment
ENVIRONMENT=test

# Elasticsearch: removed. These two were here only because config.settings made
# them REQUIRED fields, so the test suite could not import settings without them.

# Gemini API Key (tests should mock AI calls)
GEMINI_API_KEY=test-gemini-key

# Session Store Configuration (use redis for tests, but tests should mock it)
SESSION_STORE_TYPE=redis
REDIS_URL=redis://localhost:6379
SESSION_TTL_HOURS=1

# Rate Limiting (within allowed limits)
RATE_LIMIT_REQUESTS_PER_MINUTE=1000
RATE_LIMIT_AI_REQUESTS_PER_MINUTE=1000

# Observability
LOG_LEVEL=WARNING
OTEL_SERVICE_NAME=runsheet-backend-test

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000"]

# JWT Configuration removed — the homegrown HS256 legacy JWT scheme was
# retired with the SuperTokens hard cutover. No jwt_secret/jwt_algorithm.

# Auth (SuperTokens hard cutover complete)
#
# SuperTokens is the sole supported auth provider. The legacy/dual providers
# and the homegrown HS256 JWT path have been removed. The test environment is
# exempt from the fail-closed managed-core config check, so no
# SUPERTOKENS_CONNECTION_URI/API_KEY is required here; endpoint tests
# authenticate via the Test_Auth_Path dependency-override seam
# (tests/support/auth_seam.py).
AUTH_PROVIDER=supertokens
SUPERTOKENS_CONNECTION_URI=http://localhost:3567
SUPERTOKENS_API_KEY=test-supertokens-api-key

# Webhook Configuration
DINEE_WEBHOOK_SECRET=test-webhook-secret
DINEE_IDEMPOTENCY_TTL_HOURS=1

# Ops Rate Limiting (within allowed limits)
OPS_WEBHOOK_RATE_LIMIT=10000
OPS_API_RATE_LIMIT=10000
OPS_METRICS_RATE_LIMIT=1000

# Fuel Monitoring Configuration
FUEL_ALERT_DEFAULT_THRESHOLD_PCT=20.0
FUEL_CONSUMPTION_ROLLING_WINDOW_DAYS=7
FUEL_CRITICAL_DAYS_THRESHOLD=3

# Legacy Nigerian last-mile surface (OFF by default; legacy-surface tests
# opt in explicitly via LEGACY_NG_DELIVERY_ENABLED=true)
LEGACY_NG_DELIVERY_ENABLED=false

# Commerce Backbone Feature Flags (ON for testing)
COMMERCE_BACKBONE_ENABLED=true
COMMERCE_CUSTOMERS_ENABLED=true
COMMERCE_PRICING_ENGINE_ENABLED=true
COMMERCE_CREDIT_HOLDS_ENABLED=true
COMMERCE_INVOICING_ENABLED=true
COMMERCE_DUNNING_ENABLED=true

# Scheduling Configuration
SCHEDULING_DEFAULT_ETA_HOURS=4
SCHEDULING_DELAY_CHECK_INTERVAL_SECONDS=60
SCHEDULING_MAX_ACTIVE_JOBS_PER_ASSET=1

# Seed Data Configuration
SEED_TENANT_ID=test-tenant
