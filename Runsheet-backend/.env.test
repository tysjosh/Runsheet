# Test Environment Configuration
# This file contains settings for running pytest tests
# Tests should use mocked services where possible

# Environment
ENVIRONMENT=test

# Elasticsearch Configuration (tests should mock ES, but these are required for settings validation)
ELASTIC_ENDPOINT=http://localhost:9200
ELASTIC_API_KEY=test-api-key

# Gemini API Key (tests should mock AI calls)
GEMINI_API_KEY=test-gemini-key

# Session Store Configuration (use redis for tests, but tests should mock it)
SESSION_STORE_TYPE=redis
REDIS_URL=redis://localhost:6379
SESSION_TTL_HOURS=1

# Rate Limiting (within allowed limits)
RATE_LIMIT_REQUESTS_PER_MINUTE=1000
RATE_LIMIT_AI_REQUESTS_PER_MINUTE=1000

# Observability
LOG_LEVEL=WARNING
OTEL_SERVICE_NAME=runsheet-backend-test

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000"]

# JWT Configuration (must be at least 32 characters for non-development environments)
JWT_SECRET=test-jwt-secret-for-testing-only-must-be-at-least-32-chars
JWT_ALGORITHM=HS256

# Auth Migration (Migration_Controller)
#
# The platform default is now AUTH_PROVIDER=supertokens (hard cutover). The
# test environment explicitly opts back to 'legacy' so the existing suite —
# which still mints legacy Bearer dev JWTs and does not stand up a managed
# SuperTokens core — keeps working unchanged until those tests are migrated to
# the Test_Auth_Path dependency-override seam (task 16.5).
AUTH_PROVIDER=legacy

# Webhook Configuration
DINEE_WEBHOOK_SECRET=test-webhook-secret
DINEE_IDEMPOTENCY_TTL_HOURS=1

# Ops Rate Limiting (within allowed limits)
OPS_WEBHOOK_RATE_LIMIT=10000
OPS_API_RATE_LIMIT=10000
OPS_METRICS_RATE_LIMIT=1000

# Fuel Monitoring Configuration
FUEL_ALERT_DEFAULT_THRESHOLD_PCT=20.0
FUEL_CONSUMPTION_ROLLING_WINDOW_DAYS=7
FUEL_CRITICAL_DAYS_THRESHOLD=3

# Commerce Backbone Feature Flags (ON for testing)
COMMERCE_BACKBONE_ENABLED=true
COMMERCE_CUSTOMERS_ENABLED=true
COMMERCE_PRICING_ENGINE_ENABLED=true
COMMERCE_CREDIT_HOLDS_ENABLED=true
COMMERCE_INVOICING_ENABLED=true
COMMERCE_DUNNING_ENABLED=true

# Scheduling Configuration
SCHEDULING_DEFAULT_ETA_HOURS=4
SCHEDULING_DELAY_CHECK_INTERVAL_SECONDS=60
SCHEDULING_MAX_ACTIVE_JOBS_PER_ASSET=1

# Seed Data Configuration
SEED_TENANT_ID=test-tenant
