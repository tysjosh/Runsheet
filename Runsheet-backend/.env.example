# =============================================================================
# Runsheet Backend — Environment Configuration Template
# =============================================================================
#
# SETUP INSTRUCTIONS:
#   1. Copy this file to .env.development:  cp .env.example .env.development
#   2. Replace all placeholder values (marked "your-*-here") with real credentials
#   3. NEVER commit .env.development or any file with real credentials
#
# The ENVIRONMENT variable determines which .env file is loaded at runtime.
#
# -----------------------------------------------------------------------------
# REQUIRED IN staging / production — the app refuses to start without these
# -----------------------------------------------------------------------------
#   DATABASE_URL                    (see the POSTGRESQL section for why)
#   REDIS_URL                       (when SESSION_STORE_TYPE=redis)
#   SUPERTOKENS_CONNECTION_URI
#   SUPERTOKENS_API_KEY
#   CORS_ORIGINS                    (production rejects localhost origins)
#   COMMERCE_DUAL_WRITE_POSTGRES=true   (when COMMERCE_BACKBONE_ENABLED=true)
#   GEMINI_API_KEY                  (or AGENT_LLM_PROVIDER=vertex_ai — see AGENT LLM)
#
# Required for specific surfaces, but NOT enforced at startup — the feature
# degrades quietly instead, so check these against what you are enabling:
#   VOICE_API_KEY_SALT              (Dinee voice Surface B authentication)
#   FUEL_OPS_S3_BUCKET / FUEL_OPS_S3_REGION   (proof-of-delivery file storage)
#   FUEL_OPS_KMS_KEY_ID             (per-tenant integration credentials vault)
#   OPENWEATHER_API_KEY / NOAA_CDO_TOKEN      (degree-days for propane +
#                                    heating-oil consumption models)
#   OPIS_API_KEY / OPIS_API_SECRET  (live rack prices for terminal sourcing)
# =============================================================================

# =============================================================================
# ENVIRONMENT (Required)
# =============================================================================
# Determines which environment-specific .env file to load.
# Valid values: development, staging, production
# Format: string
ENVIRONMENT=development

# =============================================================================
# ELASTICSEARCH — REMOVED
# =============================================================================
# There is no Elasticsearch. The document plane is PostgreSQL: documents live in
# the ``es_documents`` table and are served by persistence/document_store.py, so
# DATABASE_URL is the only store setting. ELASTIC_ENDPOINT and ELASTIC_API_KEY
# were REQUIRED fields in config.settings and are gone from it — setting them
# here has no effect. See docs/elasticsearch-to-postgres-migration.md.

# =============================================================================
# GOOGLE CLOUD / GEMINI CONFIGURATION (Required)
# =============================================================================
# Google Cloud Platform project ID.
# Format: string, 6-30 characters
# Required: yes
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Google Cloud region for Vertex AI.
# Format: GCP region string (e.g., us-central1, europe-west1)
# Required: yes (default: us-central1)
GOOGLE_CLOUD_LOCATION=us-central1

# Path to GCP service account credentials JSON file.
# Format: absolute file path
# Required: no (not needed if using `gcloud auth application-default login`)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# =============================================================================
# AGENT LLM (Required in staging / production)
# =============================================================================
# Which provider the agent stack authenticates to. LiteLLM routes on the
# model-id prefix and the two providers use different credentials, so this is
# explicit rather than inferred:
#   gemini     -> Google AI Studio, authenticates with GEMINI_API_KEY
#   vertex_ai  -> Google Cloud, authenticates with Application Default
#                 Credentials (GOOGLE_APPLICATION_CREDENTIALS, or the platform
#                 metadata server on GCE / Cloud Run / GKE)
#
# GOOGLE_CLOUD_PROJECT alone is NOT a Gemini credential and used to look like
# one: with provider 'gemini' the model id routes to AI Studio, so a fully
# populated GCP config still failed authentication on every agent request.
# Startup now refuses staging/production when the selected provider has no
# credential. Affects the five specialists, the orchestrator's intent
# classification and the conversational surface. The deterministic overlay
# agents (routing, forecasting, prioritisation) do not use an LLM.
# Format: string (gemini / vertex_ai)
# Required: no (default: gemini)
AGENT_LLM_PROVIDER=gemini

# Model name WITHOUT a provider prefix — the prefix comes from
# AGENT_LLM_PROVIDER, and including one here is rejected at startup.
# Format: string
# Required: no (default: gemini-2.5-flash)
# AGENT_LLM_MODEL=gemini-2.5-flash

# Google AI Studio API key.
# Format: string
# Required: yes in staging / production when AGENT_LLM_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-api-key-here

# =============================================================================
# OVERLAY AGENT DEFAULT MODE
# =============================================================================
# Mode an overlay agent uses for a tenant that has no per-tenant flag
# (``overlay_ff:overlay.{agent_id}:{tenant_id}``).
#
#   disabled     — monitor_cycle skips the tenant entirely. The agent does
#                  nothing: no evaluation, no proposals, no logging.
#   shadow       — full decision logic runs and proposals are written to the
#                  agent_shadow_proposals index. Live state is NOT touched
#                  (_is_active_commit_mode returns False), so this is the
#                  intended way to observe an overlay before activating it.
#   active_gated — proposals go through the ConfirmationProtocol for approval.
#   active_auto  — same path, auto-approved where risk policy allows.
#
# Left at 'disabled' to preserve historical behaviour, but note what that
# means: ALL eleven overlay + MVP agents (tank forecasting, route planning,
# delivery prioritisation, compartment loading, exception replanning, dispatch
# optimiser, revenue guard, customer promise, exception commander, driver
# nudge, learning policy) sit idle for every tenant until either this is
# changed or each tenant is enabled through the feature-flag admin API.
#
# Bootstrap logs this at WARNING when it resolves to 'disabled', so "the agents
# aren't doing anything" is answerable from the startup log.
# Format: string (disabled / shadow / active_gated / active_auto)
# Required: no (default: disabled)
# OVERLAY_DEFAULT_MODE=shadow

# =============================================================================
# AUTHENTICATION
# =============================================================================
# JWT_SECRET and JWT_ALGORITHM used to be documented here as "Required: yes".
# Both were removed from Settings at the SuperTokens hard cutover — the legacy
# HS256 verification path no longer exists, so setting them provisions a secret
# that nothing reads. See the SUPERTOKENS section below for the real credentials.

# Demo data seeding at startup.
# When true, bootstrap/core.py calls data_seeder.seed_baseline_data at boot
# and re-seeds sample data into ES. Leave false for any real tenant
# environment so the startup path never mutates production indices.
# Format: boolean (true / false)
# Required: no (default: false)
SEED_DEMO_DATA=false

# =============================================================================
# SUPERTOKENS AUTHENTICATION (SuperTokens Auth Migration)
# =============================================================================
# SuperTokens is the identity provider and session authority. Deployment is the
# SuperTokens MANAGED SaaS core — the backend reaches a remote core over HTTPS
# using the connection URI + API key below. All values are loaded from env;
# no SuperTokens secret is hardcoded in source (Req 10.1, 10.2).

# Migration_Controller flag selecting which auth scheme is active.
# Valid values: legacy (homegrown JWT), dual (accept either, prefer SuperTokens),
#               supertokens (SuperTokens-only hard cutover)
# Format: string (legacy / dual / supertokens)
# Required: no (default: supertokens — hard cutover is the platform default;
#           set to dual/legacy to opt back during a staged rollback)
AUTH_PROVIDER=supertokens

# Managed SuperTokens core connection URI.
# Format: https://<region>.aws.supertokens.io (or your managed core endpoint)
# Required: yes when AUTH_PROVIDER is dual or supertokens in non-development envs
SUPERTOKENS_CONNECTION_URI=https://your-supertokens-core-endpoint.aws.supertokens.io

# Managed SuperTokens core API key.
# Format: string (obtain from the SuperTokens managed-service dashboard)
# Required: yes when AUTH_PROVIDER is dual or supertokens in non-development envs
SUPERTOKENS_API_KEY=your-supertokens-api-key-here

# Backend public origin serving the SDK-owned auth routes (/auth/*).
# Format: scheme://host[:port]
# Required: yes (default: http://localhost:8080)
SUPERTOKENS_API_DOMAIN=http://localhost:8080

# Frontend public origin (the Next.js app).
# Format: scheme://host[:port]
# Required: yes (default: http://localhost:3000)
SUPERTOKENS_WEBSITE_DOMAIN=http://localhost:3000

# Session cookie domain (e.g. .runsheet.app) for cross-subdomain sessions.
# Format: string (leading dot for shared parent domain) or empty
# Required: no (default: unset — host-only cookie)
# SUPERTOKENS_COOKIE_DOMAIN=.runsheet.app

# Access-token (session) lifetime in seconds.
# Format: integer, >= 60
# Required: no (default: 3600)
SESSION_LIFETIME_SECONDS=3600

# Minimum password length enforced at sign-up.
# Format: integer, 8-128
# Required: no (default: 8)
PASSWORD_MIN_LENGTH=8

# =============================================================================
# SESSION STORE CONFIGURATION (Required)
# =============================================================================
# Session store backend type.
# Valid values: redis, dynamodb
# Required: yes (default: redis)
SESSION_STORE_TYPE=redis

# Redis connection URL.
# Format: redis://<host>:<port> or redis://:<password>@<host>:<port>
# Required: yes for redis session store in non-dev environments
#           (in development, falls back to in-memory store if not set)
# REDIS_URL=redis://localhost:6379

# DynamoDB table name for session storage.
# Format: string
# Required: only if SESSION_STORE_TYPE=dynamodb
# DYNAMODB_TABLE=runsheet-sessions

# Session time-to-live in hours.
# Format: integer, 1-168
# Required: no (default: 24)
SESSION_TTL_HOURS=24

# =============================================================================
# POSTGRESQL SOURCE-OF-TRUTH (persistence/) — Optional, opt-in
# =============================================================================
# When set, PostgreSQL becomes the transactional system-of-record for the
# commerce/financial models and idempotency keys, while Elasticsearch becomes
# a rebuildable read/search projection fed by the transactional outbox. When
# EMPTY (the default), the persistence layer is dormant and the app behaves
# exactly as before (ES-only). Adoption is therefore deliberate + reversible.
#
# Use an async SQLAlchemy URL. The psycopg3 driver serves both the async
# runtime engine and Alembic's sync migration runner.
# Format: postgresql+psycopg://<user>:<pass>@<host>:<port>/<db>
# Required: YES in staging / production — the app refuses to start without it.
#           Optional (dormant) in development and test only.
#
# The "dormant" fallback is not a safe production posture. Three guarantees
# exist ONLY in Postgres, and all three fail silently when the layer is dormant:
#   * invoice numbering — invoices finalize with NO invoice_number
#   * idempotency keys — the ES index cannot stop two concurrent requests with
#     the same key from both being processed
#   * credit limits — the SELECT ... FOR UPDATE row lock has no ES equivalent,
#     so concurrent orders can exceed a limit
# DATABASE_URL=postgresql+psycopg://runsheet:runsheet@localhost:5432/runsheet

# SQLAlchemy connection pool size (ignored for sqlite).
# Format: integer, 1-100
# Required: no (default: 10)
# DATABASE_POOL_SIZE=10

# SQLAlchemy max overflow connections beyond pool_size.
# Format: integer, 0-100
# Required: no (default: 5)
# DATABASE_MAX_OVERFLOW=5

# When true, SQLAlchemy logs all emitted SQL (debug only).
# Format: boolean (true / false)
# Required: no (default: false)
# DATABASE_ECHO=false

# Commerce dual-write to Postgres.
# When true (and DATABASE_URL is set), commerce writes ALSO persist to the
# Postgres source-of-truth + transactional outbox during the migration soak.
# ES remains the read path until cutover. Requires DATABASE_URL.
# Format: boolean (true / false)
# Required: YES (true) in staging / production when COMMERCE_BACKBONE_ENABLED
#           is true — invoice numbering, payment de-duplication and the
#           credit-check row lock are all gated on it, and each degrades
#           silently when it is off. Startup refuses the combination.
#           Otherwise no (default: false).
# COMMERCE_DUAL_WRITE_POSTGRES=false

# Payments write-authoritative promotion.
# When true (and DATABASE_URL is set), PaymentService.ingest inserts the
# payment row into Postgres FIRST; the unique (tenant, source, external_id)
# constraint then REJECTS a re-delivered Stripe/QBO webhook even under
# concurrency (returns the existing payment idempotently). Enable only after
# customers/accounts/invoices are dual-written and backfilled so the payment's
# FK parents exist in Postgres.
# Format: boolean (true / false)
# Required: no (default: false)
# COMMERCE_PAYMENTS_AUTHORITATIVE=false

# Commerce read-cutover (Phase 4).
# When true (and DATABASE_URL is set), the commerce services serve reads
# (get / list / projections) from the Postgres source-of-truth instead of
# Elasticsearch, returning byte-identical document shapes. Enable only AFTER
# dual-write + the one-time backfill (python -m persistence.backfill) have
# achieved parity. This is the precondition for retiring the commerce ES
# indices: once reads no longer touch ES, the projection can be stopped and
# the indices dropped.
# Format: boolean (true / false)
# Required: no (default: false)
# COMMERCE_READ_FROM_POSTGRES=false

# DOCUMENT_STORE_BACKEND has been REMOVED. It chose where ElasticsearchService's
# document operations were served from, and Postgres is now the only
# implementation — a switch could only ever select a path that no longer exists.
# The preconditions that gated the cutover were met and recorded before it went:
# whole-cluster parity (1,426 identical query comparisons across 103 indices), an
# empty raw-client inventory, and no query shape the store refuses or silently
# drops. Rolling back is no longer a flag: it means restoring the cluster from
# es-full-backup and reverting the removal commits.
# See docs/elasticsearch-to-postgres-migration.md.

# Outbox relay (background projection of relational outbox events into the
# document store).
# When true (and DATABASE_URL is set), bootstrap starts the OutboxRelay as a
# background task that keeps the document projection in sync with the relational
# source-of-truth. Set false to run the relay out-of-band or pause projection.
# Format: boolean (true / false)
# Required: no (default: true)
# OUTBOX_RELAY_ENABLED=true

# Outbox relay idle poll interval in seconds.
# Format: float, 0.1-60.0
# Required: no (default: 1.0)
# OUTBOX_RELAY_POLL_INTERVAL_SECONDS=1.0

# =============================================================================
# RATE LIMITING CONFIGURATION
# =============================================================================
# Maximum API requests per minute per IP.
# Format: integer, 1-10000
# Required: no (default: 100)
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Maximum AI chat requests per minute per IP.
# Format: integer, 1-1000
# Required: no (default: 10)
RATE_LIMIT_AI_REQUESTS_PER_MINUTE=10

# =============================================================================
# OBSERVABILITY CONFIGURATION
# =============================================================================
# Application logging level.
# Valid values: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Required: no (default: INFO)
LOG_LEVEL=INFO

# OpenTelemetry collector endpoint for traces and metrics.
# Format: http://<host>:<port>
# Required: no (traces disabled if not set)
# OTEL_ENDPOINT=http://localhost:4317

# Service name for OpenTelemetry traces.
# Format: string
# Required: no (default: runsheet-backend)
OTEL_SERVICE_NAME=runsheet-backend

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Allowed CORS origins.
# Format: JSON array of URL strings
# Required: yes
CORS_ORIGINS=["http://localhost:3000"]

# =============================================================================
# DINEE / OPS INTELLIGENCE CONFIGURATION
# =============================================================================
# DINEE_WEBHOOK_SECRET used to be documented here as required. The global
# secret was removed from Settings: each intake channel resolves its OWN secret
# from the credentials vault, and a channel that cannot resolve one fails closed
# inside the intake pipeline. Setting a global value provisions a secret that
# nothing reads.

# Salt for the Dinee voice Surface B API-key reverse-lookup hash.
# MUST be identical anywhere a voice API key is minted (CLI / admin endpoint)
# and wherever the backend authenticates Surface B, or previously issued keys
# stop verifying. Defaults to "" and is NOT enforced at startup, so an unset
# value silently derives every stored hash from an empty salt.
# Format: string, high-entropy (e.g. `openssl rand -base64 32`)
# Required: yes when the Dinee voice surface is in use
# VOICE_API_KEY_SALT=your-voice-api-key-salt-here

# Tenant ID associated with the webhook signing secret.
# When set, rejects payloads whose tenant_id does not match.
# Format: string (UUID or tenant identifier)
# Required: no
# DINEE_WEBHOOK_TENANT_ID=your-tenant-id

# Idempotency store TTL in hours.
# Format: integer, 1-720
# Required: no (default: 72)
DINEE_IDEMPOTENCY_TTL_HOURS=72

# Dinee REST API base URL for Replay Service backfill.
# Format: https://<host>
# Required: no (replay disabled if not set)
# DINEE_API_BASE_URL=https://api.dinee.example.com

# Dinee API key for outbound Replay Service REST calls only.
# NOT used for webhook authentication.
# Format: string
# Required: no
# DINEE_API_KEY=your-dinee-api-key-here

# =============================================================================
# OPS RATE LIMITING CONFIGURATION
# =============================================================================
# Webhook rate limit per minute per IP.
# Format: integer, 1-10000
# Required: no (default: 500)
OPS_WEBHOOK_RATE_LIMIT=500

# Ops API rate limit per minute per user.
# Format: integer, 1-10000
# Required: no (default: 100)
OPS_API_RATE_LIMIT=100

# Metrics API rate limit per minute per user.
# Format: integer, 1-1000
# Required: no (default: 20)
OPS_METRICS_RATE_LIMIT=20

# =============================================================================
# FUEL MONITORING CONFIGURATION
# =============================================================================
# Default low-stock alert threshold percentage for fuel stations.
# Format: float, 0-100
# Required: no (default: 20.0)
FUEL_ALERT_DEFAULT_THRESHOLD_PCT=20.0

# Rolling window in days for daily consumption rate calculation.
# Format: integer, 1-365
# Required: no (default: 7)
FUEL_CONSUMPTION_ROLLING_WINDOW_DAYS=7

# Days until empty below which alert escalates to critical.
# Format: integer, 1-30
# Required: no (default: 3)
FUEL_CRITICAL_DAYS_THRESHOLD=3

# =============================================================================
# SCHEDULING CONFIGURATION
# =============================================================================
# Default ETA hours when no route calculation is available.
# Format: integer
# Required: no (default: 4)
SCHEDULING_DEFAULT_ETA_HOURS=4

# Interval in seconds for periodic delay detection check.
# Format: integer
# Required: no (default: 60)
SCHEDULING_DELAY_CHECK_INTERVAL_SECONDS=60

# Maximum concurrent active jobs per asset.
# Format: integer
# Required: no (default: 1)
SCHEDULING_MAX_ACTIVE_JOBS_PER_ASSET=1

# =============================================================================
# LEGACY NIGERIAN LAST-MILE FEATURE FLAG
# =============================================================================
# Single kill switch for the pre-pivot Nigerian last-mile delivery surface.
# When false (the default) these return 404 with LEGACY_NG_DELIVERY_DISABLED:
#   GET /api/ops/shipments[/{id}|/sla-breaches|/failures]
#   GET /api/ops/riders[/{id}|/utilization]
#   GET /api/ops/events
#   GET /api/ops/metrics/{shipments,sla,riders,failures}
#   POST /api/ops/replay/trigger, GET /api/ops/replay/status/{job_id}
#   POST /api/ops/drift/run
#   GET /api/support/tickets, GET /api/search?index=support_tickets
# Ops platform monitoring (/api/ops/monitoring/*, /api/ops/metrics/prometheus)
# and the per-tenant feature-flag admin routes stay available so a disabled
# surface can still be observed and managed.
# Format: boolean (true / false)
# Required: no (default: false)
LEGACY_NG_DELIVERY_ENABLED=false

# =============================================================================
# COMMERCE BACKBONE FEATURE FLAGS
# =============================================================================
# These flags control the Commerce Backbone module rollout.
# The master flag (COMMERCE_BACKBONE_ENABLED) gates all commerce endpoints.
# Sub-flags are independently gateable for staged rollout (Req 8.2).
# Default: false (off). Set to true in development for local testing.

# Master flag — when off, all commerce endpoints return 404.
# Format: boolean (true / false)
# Required: no (default: false)
COMMERCE_BACKBONE_ENABLED=false

# Customer master endpoints and service.
# Format: boolean (true / false)
# Required: no (default: false)
COMMERCE_CUSTOMERS_ENABLED=false

# PricingEngine hook on order intake pipeline.
# Format: boolean (true / false)
# Required: no (default: false)
COMMERCE_PRICING_ENGINE_ENABLED=false

# Credit-hold enforcement on order intake.
# Format: boolean (true / false)
# Required: no (default: false)
COMMERCE_CREDIT_HOLDS_ENABLED=false

# Automatic invoice generation on order delivery.
# Format: boolean (true / false)
# Required: no (default: false)
COMMERCE_INVOICING_ENABLED=false

# Dunning service for automated collection notifications.
# Format: boolean (true / false)
# Required: no (default: false)
COMMERCE_DUNNING_ENABLED=false

# =============================================================================
# ORDER INTAKE PIPELINE CONFIGURATION
# =============================================================================
# Shadow-mode divergence sample rate.
# Fraction of orders sampled for divergence comparison between the new
# intake pipeline and the legacy path during shadow rollout.
# 0.0 = no sampling, 1.0 = sample all orders.
# Format: float, 0.0-1.0
# Required: no (default: 1.0)
# Note: Only relevant when the order_intake_pipeline feature flag is in
#       shadow mode. Has no effect when the pipeline is disabled or active.
ORDERS_INTAKE_PIPELINE_SHADOW_DIVERGENCE_SAMPLE_RATE=1.0

# Legacy shipment/rider route sunset date.
# ISO-8601 date after which legacy routes return 410 Gone for tenants
# that have completed migration. When unset (default), legacy routes
# remain active indefinitely — no sunset is scheduled.
# Format: ISO-8601 date string (e.g. 2026-07-01) or empty/unset
# Required: no (default: not set — legacy routes stay active)
# ORDERS_LEGACY_SUNSET_DATE=

# Legacy read retention days.
# Number of days to retain read access to legacy shipment/rider indices
# after the sunset date passes. Allows historical queries during the
# transition period.
# Format: integer, >= 1
# Required: no (default: 30)
ORDERS_LEGACY_READ_RETENTION_DAYS=30

# =============================================================================
# AWS-BACKED FUEL-OPS SURFACES (read from the process environment)
# =============================================================================
# These three are read directly by bootstrap/agents.py::_resolve_fuel_ops_settings
# — they are NOT pydantic Settings fields, so nothing validates them and nothing
# fails at startup when they are absent. Each service is simply skipped, logged
# at INFO, and the surface that depends on it degrades quietly.
#
# On AWS, credentials come from the task/instance role; do not set AWS access
# keys here.

# S3 bucket + region for proof-of-delivery object storage and presigned URLs.
# Without BOTH, FileStorageService is not registered — and because the OCR
# service needs it, MeterTicketOCRService is skipped too, so the driver POD flow
# falls back to manual `delivered_gallons` entry with no error surfaced.
# Format: bucket name / AWS region (FUEL_OPS_S3_REGION falls back to AWS_REGION,
#         then AWS_DEFAULT_REGION)
# Required: yes when the proof-of-delivery or meter-ticket OCR surface is in use
# FUEL_OPS_S3_BUCKET=runsheet-pod-documents
# FUEL_OPS_S3_REGION=us-east-1

# KMS CMK used for envelope encryption of per-tenant integration credentials.
# Without it TenantCredentialsVault still registers but `put` raises
# "kms_key_id required" unless every caller passes a key explicitly, and a
# WARNING is logged at boot naming the consequence.
#
# Only `development` and `test` fall back to the in-process LocalKMSClient.
# STAGING and PRODUCTION both require a real CMK: the local client's master key
# is derived from a literal committed to this repository, so using it anywhere
# that holds real QuickBooks / Stripe / Geotab tokens would mean anyone with
# repo access can decrypt them. Set LOCAL_KMS_MASTER_KEY for a per-developer
# key if you want dev blobs to be private too.
# Format: KMS key id, alias or ARN
# Required: yes in staging / production when per-tenant integration credentials
#           are stored
# FUEL_OPS_KMS_KEY_ID=alias/runsheet-tenant-credentials

# =============================================================================
# EXTERNAL DATA PROVIDERS (read from the process environment)
# =============================================================================
# Each adapter below is fully implemented. Without its credential the agent
# that consumes it still runs — on no external data — and says so only through
# a fallback annotation on its output. Set these if the corresponding surface
# is meant to reflect the real world.

# --- Weather / degree-days -----------------------------------------------
# Feeds Heating-Degree-Days into the propane and heating-oil consumption models
# used by the Tank_Forecasting_Agent. Bootstrap picks OpenWeather when its key
# is present, otherwise NOAA, otherwise registers no provider at all — in which
# case every propane / heating-oil forecast carries ``weather_fallback: true``
# and is computed without degree-days, which is the dominant term.
# Observations are also persisted to the ``weather_observations`` index, which
# is what gives the compliance K-factor service real HDD to calibrate against.
# Format: string
# Required: yes when propane / heating-oil forecasting must be accurate
# OPENWEATHER_API_KEY=your-openweather-api-key-here
# NOAA_CDO_TOKEN=your-noaa-cdo-token-here

# Force a specific adapter instead of auto-selecting from the keys above.
# Format: string (openweather / noaa)
# Required: no
# FUEL_OPS_WEATHER_PROVIDER=openweather

# --- Rack prices ---------------------------------------------------------
# Live terminal rack prices for the Sourcing_Recommender. Without OPIS the
# provider falls back to a tenant-uploaded CSV — and the upload path is not
# built yet (no endpoint for the ``rack_csv`` category and nowhere to record
# the resulting file_ref), so terminal sourcing has NO price data and returns
# ``no_price_available`` for every candidate.
# Format: string
# Required: yes when terminal sourcing must score candidates on real prices
# OPIS_API_KEY=your-opis-api-key-here
# OPIS_API_SECRET=your-opis-api-secret-here
# OPIS_BASE_URL=https://api.opisnet.example.com

# Force a specific adapter instead of auto-selecting on OPIS_API_KEY.
# Format: string (opis / csv_fallback)
# Required: no
# FUEL_OPS_RACK_PRICE_PROVIDER=opis

# --- Traffic-aware routing -----------------------------------------------
# The Route_Planning_Agent is wired for these, but engaging them also needs the
# per-tenant ``overlay.traffic_aware_routing`` flag enabled (seeded DISABLED)
# and an ``overlay.traffic_provider:{tenant_id}`` Redis value. Without all
# three, routing uses Haversine at DEFAULT_SPEED_KMH and stamps
# ``traffic_fallback: true``.
# Format: string
# Required: no
