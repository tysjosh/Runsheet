<mjml>
  <mj-head>
    <mj-title>Final Payment Notice - 30 Days Overdue</mj-title>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="14px" color="#333333" line-height="1.6" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <mj-section background-color="#ffffff" padding="20px">
      <mj-column>
        <mj-text font-size="20px" font-weight="bold" color="#cc0000">
          Final Payment Notice
        </mj-text>
        <mj-divider border-color="#cc0000" />
        <mj-text>
          Dear {{customer_name}},
        </mj-text>
        <mj-text>
          Despite previous notices, invoice <strong>{{invoice_number}}</strong>
          for account <strong>{{account_name}}</strong> remains unpaid. This
          invoice was due on <strong>{{due_date}}</strong> and is now
          <strong>{{days_overdue}} days</strong> past due.
        </mj-text>
        <mj-text>
          <strong>Invoice Total:</strong> {{total_amount}}<br/>
          <strong>Remaining Balance:</strong> {{remaining_amount}}
        </mj-text>
        <mj-text color="#cc0000" font-weight="bold">
          This is your final notice before account action is taken.
        </mj-text>
        <mj-text>
          Immediate payment is required to maintain your account in good
          standing. Failure to remit payment may result in:
        </mj-text>
        <mj-text padding-left="20px">
          • Suspension of credit privileges<br/>
          • Hold on all pending and future orders<br/>
          • Referral to collections
        </mj-text>
        <mj-text>
          Please contact our billing team immediately if you are experiencing
          difficulties or wish to arrange a payment plan.
        </mj-text>
        <mj-divider border-color="#e0e0e0" />
        <mj-text font-size="12px" color="#666666">
          This is an automated notice. Please do not reply directly to this email.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
